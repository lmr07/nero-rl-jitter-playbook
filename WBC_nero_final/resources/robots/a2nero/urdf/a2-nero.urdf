            </geometry>
            <material name="gripper_imu_cam_material">
                <color rgba="0.69804 0.69804 0.69804 1"/>
            </material>
        </visual>
        <!-- Disabled because this fixed internal bracket overlapped the IMU:
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../nero-meshes/gripper_imu_cam.stl"/>
            </geometry>
        </collision>
        -->
    </link>

