    <!-- ===================== 夹爪末端 IMU 与 D435i ===================== -->
    <!--
      支架 Y 轴与 gripper_base 电机 Z 轴同轴；绕 X、Z 各旋转 +90 度后，
      y=0 一侧的两个小孔朝向 gripper_base 的两个小孔。支架安装端面位于
      gripper_base 侧耳底面 z=0.046 m，两面相切且实体不相交。
    -->
    <joint name="gripper_imu_cam_mount_joint" type="fixed">
        <origin xyz="0 0 0.046" rpy="1.57079632679 0 1.57079632679"/>
        <parent link="gripper_base"/>
        <child link="gripper_imu_cam"/>
    </joint>

    <link name="gripper_imu_cam">
        <inertial>
            <origin xyz="-0.0032207 -0.023868 0.029524" rpy="0 0 0"/>
            <mass value="0.060921"/>
            <inertia ixx="5.7574E-05" ixy="-8.1082E-07" ixz="2.8147E-06"
                     iyy="6.3016E-05" iyz="7.5764E-06" izz="3.4755E-05"/>
