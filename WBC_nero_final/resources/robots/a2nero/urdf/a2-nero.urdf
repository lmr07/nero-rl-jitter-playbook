        <!-- Replaced by the active box collision below to preserve clearance:
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../nero-meshes/gripper_link1.stl"/>
            </geometry>
        </collision>
        -->
        <collision>
            <!-- Keep 3 mm clearance from gripper_base at the closed rail end. -->
            <origin xyz="0 -0.035 0.01325" rpy="0 0 0"/>
            <geometry>
                <box size="0.052 0.070 0.022"/>
            </geometry>
        </collision>
